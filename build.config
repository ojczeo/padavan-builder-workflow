### Target Vendor/Product (ASUS RT-AC51U)
CONFIG_VENDOR=ASUS
CONFIG_FIRMWARE_PRODUCT_ID="RT-AC51U"

### Target CPU frequency (580 MHz)
CONFIG_FIRMWARE_CPU_580MHZ=y

### Flash size (16MB)
CONFIG_FIRMWARE_ROOTFS_IN_RAM=n
CONFIG_FIRMWARE_TRX_MAX_SIZE=0xF80000

### USB & Storage Support
CONFIG_FIRMWARE_ENABLE_USB=y
CONFIG_FIRMWARE_ENABLE_FAT=y
CONFIG_FIRMWARE_ENABLE_NTFS=n
CONFIG_FIRMWARE_ENABLE_EXT2=y
CONFIG_FIRMWARE_ENABLE_EXT3=y
CONFIG_FIRMWARE_ENABLE_EXT4=y
CONFIG_FIRMWARE_ENABLE_XFS=n
CONFIG_FIRMWARE_ENABLE_FUSE=n
CONFIG_FIRMWARE_ENABLE_SWAP=y

### USB Modems & Phone Tethering (iPhone + Android)
CONFIG_FIRMWARE_INCLUDE_USB_MODEM=y
CONFIG_FIRMWARE_INCLUDE_USB_SERIAL=y
CONFIG_FIRMWARE_INCLUDE_RNDIS=y
CONFIG_FIRMWARE_INCLUDE_NCM=y
CONFIG_FIRMWARE_INCLUDE_QMI=y
CONFIG_FIRMWARE_INCLUDE_MBIM=y
CONFIG_FIRMWARE_INCLUDE_IPHETH=y

### Network & VPN Features
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y
CONFIG_FIRMWARE_INCLUDE_OPENVPN=n
CONFIG_FIRMWARE_INCLUDE_IPSET=y
CONFIG_FIRMWARE_INCLUDE_IPT_ACCOUNT=n
CONFIG_FIRMWARE_INCLUDE_EBTABLES=y
CONFIG_FIRMWARE_INCLUDE_SSWAN=n
CONFIG_FIRMWARE_INCLUDE_L2TP=y
CONFIG_FIRMWARE_INCLUDE_PPTP=y
CONFIG_FIRMWARE_INCLUDE_SOFTETHER=n
CONFIG_FIRMWARE_INCLUDE_DNSCRYPT=n
CONFIG_FIRMWARE_INCLUDE_DOH=y

### Utilities & Services (Lightweight for 64MB RAM)
CONFIG_FIRMWARE_INCLUDE_OPENSSH=n
CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y
CONFIG_FIRMWARE_INCLUDE_SFTP=y
CONFIG_FIRMWARE_INCLUDE_CURL=y
CONFIG_FIRMWARE_INCLUDE_WGET_SSL=y
CONFIG_FIRMWARE_INCLUDE_TCPDUMP=n
CONFIG_FIRMWARE_INCLUDE_MTR=n
CONFIG_FIRMWARE_INCLUDE_I2C=n
CONFIG_FIRMWARE_INCLUDE_SMBD=n
CONFIG_FIRMWARE_INCLUDE_WSDD2=n
CONFIG_FIRMWARE_INCLUDE_NMBD=n
CONFIG_FIRMWARE_INCLUDE_VSFTPD=n
CONFIG_FIRMWARE_INCLUDE_MINIDLNA=n
CONFIG_FIRMWARE_INCLUDE_FIREFLY=n
CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=n
CONFIG_FIRMWARE_INCLUDE_ARIA=n
CONFIG_FIRMWARE_INCLUDE_LPRD=n
CONFIG_FIRMWARE_INCLUDE_U2EC=n
CONFIG_FIRMWARE_INCLUDE_XUPNPD=n
CONFIG_FIRMWARE_INCLUDE_NFSD=n
CONFIG_FIRMWARE_INCLUDE_HDIDLE=n
CONFIG_FIRMWARE_INCLUDE_SMARTMONTOOLS=n
CONFIG_FIRMWARE_INCLUDE_PARTED=n

### WebUI Languages (English + Polish)
CONFIG_FIRMWARE_INCLUDE_LANG_EN=y
CONFIG_FIRMWARE_INCLUDE_LANG_PL=y
CONFIG_FIRMWARE_INCLUDE_LANG_RU=n
CONFIG_FIRMWARE_INCLUDE_LANG_DE=n
CONFIG_FIRMWARE_INCLUDE_LANG_FR=n
CONFIG_FIRMWARE_INCLUDE_LANG_ES=n
CONFIG_FIRMWARE_INCLUDE_LANG_IT=n
CONFIG_FIRMWARE_INCLUDE_LANG_UK=n
CONFIG_FIRMWARE_INCLUDE_LANG_CZ=n
CONFIG_FIRMWARE_INCLUDE_LANG_SV=n
CONFIG_FIRMWARE_INCLUDE_LANG_DA=n
CONFIG_FIRMWARE_INCLUDE_LANG_FI=n
CONFIG_FIRMWARE_INCLUDE_LANG_NO=n
CONFIG_FIRMWARE_INCLUDE_LANG_BR=n
CONFIG_FIRMWARE_INCLUDE_LANG_NL=n
CONFIG_FIRMWARE_INCLUDE_LANG_RO=n
CONFIG_FIRMWARE_INCLUDE_LANG_TR=n
